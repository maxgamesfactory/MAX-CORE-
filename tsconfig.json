{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true, "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true, "skipLibCheck": true,
    "declaration": true, "sourceMap": true, "outDir": "dist"
  },
  "include": ["index.ts", "contracts/**/*.ts", "state/**/*.ts", "events/**/*.ts", "simulation/**/*.ts", "runtime/**/*.ts", "storage/**/*.ts", "intelligence/**/*.ts", "adapters/**/*.ts", "tests/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
