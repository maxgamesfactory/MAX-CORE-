{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"], "strict": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "useUnknownInCatchVariables": true,
    "declaration": true, "sourceMap": true, "outDir": "dist", "rootDir": ".",
    "noImplicitOverride": true, "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["index.ts", "contracts/**/*.ts", "state/**/*.ts", "events/**/*.ts", "simulation/**/*.ts", "runtime/**/*.ts", "adapters/**/*.ts", "storage/**/*.ts"]
}
